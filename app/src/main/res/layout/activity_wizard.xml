<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/CS.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wizard_title"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/textWizardProgress"
        style="@style/CS.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <ProgressBar
        android:id="@+id/progressWizard"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:progressTint="@color/cs_accent" />

    <LinearLayout
        style="@style/CS.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textWizardTag"
            style="@style/CS.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/wizard_optional"
            android:textColor="@color/cs_accent_dark"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textWizardStepTitle"
            style="@style/CS.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textWizardBody"
            style="@style/CS.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textWizardStatus"
            style="@style/CS.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnWizardAction"
            style="@style/CS.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnWizardBack"
            style="@style/CS.ButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wizard_back" />

        <Button
            android:id="@+id/btnWizardNext"
            style="@style/CS.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/wizard_next" />
    </LinearLayout>
</LinearLayout>
