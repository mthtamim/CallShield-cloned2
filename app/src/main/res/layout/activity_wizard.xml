<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wizard_title"
                android:textSize="24sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please grant the following permissions to ensure CallShield works correctly."
                android:layout_marginBottom="24dp"/>

            <!-- Dynamic list of permissions will be populated here -->
            <LinearLayout
                android:id="@+id/wizardPermissionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/cs_card"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnWizardFinish"
            style="@style/CS.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finish Setup" />
    </LinearLayout>

</LinearLayout>
