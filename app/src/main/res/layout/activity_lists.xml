<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/CS.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lists_title"
        android:textSize="20sp" />

    <Spinner
        android:id="@+id/spinnerListType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/textListHint"
        style="@style/CS.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <ListView
        android:id="@+id/listItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp" />

    <TextView
        android:id="@+id/textEmptyList"
        style="@style/CS.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_list"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- v1.2.0: Add is the tinted outline button (tinted per
             section at runtime, like the reference design); Pick
             contact is the filled primary. -->
        <Button
            android:id="@+id/btnAddManual"
            style="@style/CS.ButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/add_manual" />

        <Button
            android:id="@+id/btnPickContact"
            style="@style/CS.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/pick_contact" />
    </LinearLayout>
</LinearLayout>
