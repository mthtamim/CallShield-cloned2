<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/CS.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/security_title"
            android:textSize="20sp" />

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lock_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/lock_section_desc" />

            <TextView
                android:id="@+id/textLockState"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Switch
                android:id="@+id/switchLock"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lock_switch" />

            <Switch
                android:id="@+id/switchBiometric"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/lock_biometric_switch" />

            <Button
                android:id="@+id/btnSetPin"
                style="@style/CS.ButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/lock_set_pin" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/storage_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/storage_desc" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/backup_desc" />

            <Button
                android:id="@+id/btnExport"
                style="@style/CS.ButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/backup_export" />

            <Button
                android:id="@+id/btnImport"
                style="@style/CS.ButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/backup_import" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
