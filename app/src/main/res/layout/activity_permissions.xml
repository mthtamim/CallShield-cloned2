<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/CS.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/perm_title"
            android:textSize="20sp" />

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_role_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_role_desc" />

            <TextView
                android:id="@+id/textRolePermStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnRole"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_open" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_contacts_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_contacts_desc" />

            <TextView
                android:id="@+id/textContactsPermStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnContacts"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_open" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_calllog_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_calllog_desc" />

            <TextView
                android:id="@+id/textCallLogPermStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnCallLog"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_open" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_notif_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_notif_desc" />

            <TextView
                android:id="@+id/textNotifPermStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnNotif"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_open" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_battery_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_battery_desc" />

            <TextView
                android:id="@+id/textBatteryPermStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnBattery"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_open" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_sms_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_sms_desc" />

            <TextView
                android:id="@+id/textSmsPermStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnSms"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_open" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_notifaccess_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_notifaccess_desc" />

            <TextView
                android:id="@+id/textNotifAccessStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnNotifAccess"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_open" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_alarm_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_alarm_desc" />

            <TextView
                android:id="@+id/textAlarmPermStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnAlarm"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_open" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_phone_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_phone_desc" />

            <TextView
                android:id="@+id/textPhonePermStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnPhone"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_open" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_sendsms_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_sendsms_desc" />

            <TextView
                android:id="@+id/textSendSmsPermStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnSendSms"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_open" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_calendar_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_calendar_desc" />

            <TextView
                android:id="@+id/textCalendarPermStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnCalendar"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_open" />
        </LinearLayout>

        <!-- v1.1.1: the old Battery guide screen is folded in here. Its
             live status lines duplicated the battery / role / alarm
             cards above; only the explanatory OEM steps were unique,
             and this is now their one home. -->
        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/battery_title" />

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/battery_xos_label" />

            <TextView
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/battery_xos_steps" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/battery_general_note" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
