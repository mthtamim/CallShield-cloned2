<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/CS.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="20sp" />

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_label" />

            <RadioGroup
                android:id="@+id/radioGroupMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/radioContacts"
                    style="@style/CS.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_contacts" />

                <RadioButton
                    android:id="@+id/radioFavorites"
                    style="@style/CS.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_favorites" />
            </RadioGroup>

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mode_desc" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hidden_label" />

            <RadioGroup
                android:id="@+id/radioGroupHidden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/radioHiddenBlock"
                    style="@style/CS.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hidden_block" />

                <RadioButton
                    android:id="@+id/radioHiddenAllow"
                    style="@style/CS.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hidden_allow" />

                <RadioButton
                    android:id="@+id/radioHiddenWarn"
                    style="@style/CS.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hidden_warn" />
            </RadioGroup>

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/hidden_desc" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <Switch
                android:id="@+id/switchEscalation"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/escalation_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/escalation_desc" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/v11_behaviour_label" />

            <Switch
                android:id="@+id/switchSoftScreen"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/soft_screen_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/soft_screen_desc" />

            <Switch
                android:id="@+id/switchSilentNotif"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/silent_notif_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/silent_notif_desc" />

            <TextView
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/autoclean_label" />

            <Spinner
                android:id="@+id/spinnerAutoclean"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/autoclean_desc" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_label" />

            <RadioGroup
                android:id="@+id/radioGroupLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/radioBn"
                    style="@style/CS.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_bn" />

                <RadioButton
                    android:id="@+id/radioEn"
                    style="@style/CS.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_en" />
            </RadioGroup>

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/theme_label" />

            <RadioGroup
                android:id="@+id/radioGroupTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/radioThemeSystem"
                    style="@style/CS.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_system" />

                <RadioButton
                    android:id="@+id/radioThemeDark"
                    style="@style/CS.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_dark" />

                <RadioButton
                    android:id="@+id/radioThemeLight"
                    style="@style/CS.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_light" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSettings"
            style="@style/CS.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/save" />
    </LinearLayout>
</ScrollView>
