<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/CS.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_title"
            android:textSize="20sp" />

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTotals"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trend_label" />

            <TextView
                android:id="@+id/textTrend"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/top_label" />

            <LinearLayout
                android:id="@+id/topRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quiet_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quiet_desc" />

            <LinearLayout
                android:id="@+id/quietRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/summary_label" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/summary_desc" />

            <Switch
                android:id="@+id/switchSummary"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/summary_switch" />

            <EditText
                android:id="@+id/editSummaryHour"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/summary_hour_hint"
                android:inputType="number" />

            <Button
                android:id="@+id/btnSaveSummary"
                style="@style/CS.ButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
