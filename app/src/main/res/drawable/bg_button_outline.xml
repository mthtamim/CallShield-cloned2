<?xml version="1.0" encoding="utf-8"?>
<!-- v1.2.0 tinted outline button: transparent fill, coloured stroke.
     ListsActivity tints it per section (green whitelist, red blacklist,
     blue prefixes) via backgroundTintList — the tint lands on the stroke
     only, like the reference design's "+ Add to Blacklist" button. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/cs_accent" />
</shape>
