<?xml version="1.0" encoding="utf-8"?>
<!-- v1.2.0 dashboard hero: green-to-blue gradient with a soft border,
     20dp radius (the reference design's signature card). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="@color/cs_hero_end"
        android:startColor="@color/cs_hero_start"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/cs_hero_border" />
</shape>
