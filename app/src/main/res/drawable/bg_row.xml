<?xml version="1.0" encoding="utf-8"?>
<!-- v1.2.0 list row card: surface + border, 14dp radius. Used by
     item_row (Lists / Log via RowAdapter) and the dashboard's
     code-built recent-block rows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="@color/cs_card" />
    <stroke
        android:width="1dp"
        android:color="@color/cs_divider" />
</shape>
